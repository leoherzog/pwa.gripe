{%- macro support_cell(value, note) %}
              <td>
                {%- if value == 'y' %}<span class="support-y" role="img" aria-label="Supported">&#x2714;&#xFE0E;</span>
                {%- elif note %}<span class="support-a" role="img" aria-label="Partial support: {{ note }}" data-tooltip="{{ note }}" tabindex="0">&#x26A0;&#xFE0E;</span>
                {%- elif value == 'a' %}<span class="support-a" role="img" aria-label="Partial support">&#x26A0;&#xFE0E;</span>
                {%- else %}<span class="support-n" role="img" aria-label="Not supported">&#x2718;</span>
                {%- endif -%}
              </td>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>pwa.gripe — What Apple Still Won't Let You Do</title>
  <meta name="description" content="See which PWA features are supported on Chrome, Safari, and your browser.">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#13171f">
  <link rel="canonical" href="https://pwa.gripe/">
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://pwa.gripe/">
  <meta property="og:title" content="pwa.gripe — What Apple Still Won't Let You Do">
  <meta property="og:description" content="See which PWA features are supported on Chrome, Safari, and your browser.">
  <meta property="og:image" content="https://pwa.gripe/icons/icon-512.png">
  <meta property="og:image:alt" content="pwa.gripe app icon">
  <meta property="og:site_name" content="pwa.gripe">
  <meta property="og:locale" content="en_US">
  <meta name="twitter:card" content="summary">

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2.1.1/css/pico.min.css" integrity="sha384-L1dWfspMTHU/ApYnFiMz2QID/PlP1xCW9visvBdbEkOLkSSWsP6ZJWhPw6apiXxU" crossorigin="anonymous">
  <script>
    // Applies a saved theme before first paint; app.js runs the toggle.
    try {
      const theme = localStorage.getItem("theme");
      if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
    } catch {}
  </script>
  <style>
    @media (max-width: 575.98px) {
      :root { --pico-spacing: 0.5rem; }
    }

    .support-y { color: var(--pico-ins-color); }
    .support-a { color: light-dark(#977000, #ffbf00); }
    .support-n { color: var(--pico-del-color); }
    .support-u { color: var(--pico-muted-color); }

    tr.gripe > * { background-color: color-mix(in srgb, var(--pico-del-color) 10%, var(--pico-background-color)); }

    td,
    thead th:not(:first-child) {
      text-align: center;
    }

    td {
      font-size: 2rem;
    }

    /* Long feature names would otherwise push Your Browser off 360px screens. */
    tbody th {
      hyphens: auto;
      overflow-wrap: anywhere;
    }

    /* Pico sizes tooltips to half their host; let them grow to a readable width instead. */
    [data-tooltip]::before {
      width: max-content;
      max-width: min(40ch, 50vw);
      white-space: normal;
      text-align: start;
    }

    article {
      max-width: 1200px;
      margin-inline: auto;
    }

    article > footer {
      text-align: center;
    }

    #theme-toggle {
      --pico-background-color: transparent;
      --pico-border-color: transparent;
      --pico-color: var(--pico-muted-color);
      font-size: 1.25rem;
    }
  </style>
</head>
<body>
  <main class="container">
    <article>
      <nav>
        <ul>
          <li>
            <hgroup>
                <h1>&#x1F4F1; pwa.gripe</h1>
                <p>Apple's intentional crippling of Safari on iOS and iPadOS is sacrificing the open web on the altar of more App Store sales</p>
            </hgroup>
          </li>
        </ul>
        <ul>
          <li>
            <button id="theme-toggle" data-tooltip="Theme: Auto" data-placement="left" aria-label="Theme: Auto. Switch to Light">&#x25D1;</button>
          </li>
        </ul>
      </nav>

      <div class="overflow-auto">
        <table>
          <thead>
            <tr>
              <th scope="col">Feature</th>
              <th scope="col">Chrome {{ android_version }}<br><small>Android</small></th>
              <th scope="col">Mobile Safari {{ ios_version }}<br><small>iOS + iPadOS</small></th>
              <th scope="col">Your Browser</th>
            </tr>
          </thead>
          <tbody>
            {%- for f in features %}
            <tr{% if f.group == 0 %} class="gripe"{% endif %}>
              <th scope="row"><a href="{{ f.url }}" target="_blank">{{ f.name }}</a><br><small>{{ f.description }}</small></th>
              {{- support_cell(f.android, f.android_note) }}
              {{- support_cell(f.ios, f.ios_note) }}
              {%- if f.detect %}
              <td data-detect="{{ f.detect }}"></td>
              {%- else %}
              <td><span class="support-u" role="img" aria-label="Unknown: not detectable from JavaScript" data-tooltip="Not detectable from JavaScript" data-placement="left" tabindex="0">?</span></td>
              {%- endif %}
            </tr>
            {%- endfor %}
          </tbody>
        </table>
      </div>

      <footer>
        <small>
          Data from <a href="https://caniuse.com">caniuse.com</a> &middot;
          Inspired by <a href="https://whatpwacando.today">whatpwacando.today</a> &middot;
          Updated {{ updated }}  &middot;
          <a href="https://herzog.tech/" target="_blank">&hearts; herzog.tech</a>
        </small>
      </footer>
    </article>
  </main>

  <script type="module" src="app.js"></script>
</body>
</html>
